{
  "name": "memeit",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel dev",
    "dev:web": "pnpm --filter @memeit/web dev",
    "dev:api": "pnpm --filter @memeit/render-api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm -r build && node scripts/verify-project.mjs",
    "verify:schema": "pnpm --filter @memeit/timeline gen:schema:check",
    "verify:local": "node packages/memeit/dist/cli.js verify",
    "render:local": "node packages/memeit/dist/cli.js render"
  },
  "devDependencies": {
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20"
  }
}
